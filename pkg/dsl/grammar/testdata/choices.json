    "diagnosticCode": {
      "doc": "Every code artemis parse --json can emit. These are stable independently of message text: key behaviour off the code, never off the message.",
      "values": [
        {
          "value": "action-not-first",
          "doc": "a step statement appears above the step's action block",
          "severity": "error"
        },
        {
          "value": "bad-arity",
          "doc": "a call or a browser action has the wrong number of arguments",
          "severity": "error"
        },
        {
          "value": "bad-collection-name",
          "doc": "a collection's name is not an identifier, so no use can name it",
          "severity": "error"
        },
        {
          "value": "bad-override",
          "doc": "a line in a use block is not an argument or an override that applies",
          "severity": "error"
        },
        {
          "value": "bad-value",
          "doc": "a value is the wrong kind for the position it is in",
          "severity": "error"
        },
        {
          "value": "drop-after-expect",
          "doc": "a drop expects line comes after an expect line in the same use block",
          "severity": "error"
        },
        {
          "value": "dropped-capture",
          "doc": "a step a use brought in reads a capture that drop captures removed",
          "severity": "error"
        },
        {
          "value": "duplicate-action",
          "doc": "a step block contains more than one action block",
          "severity": "error"
        },
        {
          "value": "duplicate-argument",
          "doc": "a use passes the same argument twice",
          "severity": "error"
        },
        {
          "value": "duplicate-binding",
          "doc": "a capture reuses the name of a var or of an earlier capture",
          "severity": "error"
        },
        {
          "value": "duplicate-collection",
          "doc": "two collections in scope have the same name",
          "severity": "error"
        },
        {
          "value": "import-cycle",
          "doc": "a file imports itself, directly or through other files",
          "severity": "error"
        },
        {
          "value": "import-needs-file",
          "doc": "a file read from no disk imports another file",
          "severity": "error"
        },
        {
          "value": "import-not-found",
          "doc": "an imported file cannot be read",
          "severity": "error"
        },
        {
          "value": "import-placement",
          "doc": "an import appears below a collection or a scenario",
          "severity": "error"
        },
        {
          "value": "invalid-duration",
          "doc": "a string in a duration position is not a duration",
          "severity": "error"
        },
        {
          "value": "invalid-escape",
          "doc": "a string literal contains an escape the language does not define",
          "severity": "error"
        },
        {
          "value": "invalid-regex",
          "doc": "a regex literal does not compile",
          "severity": "error"
        },
        {
          "value": "missing-action",
          "doc": "a step block contains no action block, so the step has no type",
          "severity": "error"
        },
        {
          "value": "missing-argument",
          "doc": "a use does not pass a parameter that has no default",
          "severity": "error"
        },
        {
          "value": "missing-separator",
          "doc": "two statements run together with no newline or comma between them",
          "severity": "error"
        },
        {
          "value": "nesting-too-deep",
          "doc": "a file nests deeper than the parser will descend",
          "severity": "error"
        },
        {
          "value": "non-associative-operator",
          "doc": "a comparison operator is chained with another",
          "severity": "error"
        },
        {
          "value": "not-in-scope",
          "doc": "a name is not bound in this step's type",
          "severity": "error"
        },
        {
          "value": "reserved-param",
          "doc": "a parameter is named like a use-block override word, so no use can pass it",
          "severity": "error"
        },
        {
          "value": "reserved-word",
          "doc": "a word reserved for a later tier is used as a name",
          "severity": "error"
        },
        {
          "value": "secret-argument",
          "doc": "an argument to a secret parameter is not itself secret",
          "severity": "error"
        },
        {
          "value": "unclosed-block",
          "doc": "a \"{\", \"(\" or \"[\" is never closed",
          "severity": "error"
        },
        {
          "value": "unclosed-interpolation",
          "doc": "a \"${\" in a string has no closing \"}\"",
          "severity": "error"
        },
        {
          "value": "unclosed-interpolation-expr",
          "doc": "a \"${\" expression is followed by neither \"}\" nor more string",
          "severity": "error"
        },
        {
          "value": "unexpected-character",
          "doc": "a byte in the source starts no token",
          "severity": "error"
        },
        {
          "value": "unexpected-token",
          "doc": "a token appears where the grammar wanted another",
          "severity": "error"
        },
        {
          "value": "unknown-argument",
          "doc": "a use passes an argument the item has no parameter for",
          "severity": "error"
        },
        {
          "value": "unknown-collection",
          "doc": "a use names a collection that is not in scope",
          "severity": "error"
        },
        {
          "value": "unknown-config",
          "doc": "a \"config\" names a subject the language does not configure",
          "severity": "error"
        },
        {
          "value": "unknown-field",
          "doc": "an identifier names no field of anything in scope",
          "severity": "error"
        },
        {
          "value": "unknown-flow-step",
          "doc": "an in block names a step the flow does not have",
          "severity": "error"
        },
        {
          "value": "unknown-identifier",
          "doc": "a name is bound nowhere in the file",
          "severity": "error"
        },
        {
          "value": "unknown-item",
          "doc": "a use names a request or flow its collection does not declare",
          "severity": "error"
        },
        {
          "value": "unknown-type",
          "doc": "the right-hand side of \"is\" is not a type name",
          "severity": "error"
        },
        {
          "value": "unterminated-regex",
          "doc": "a regex literal has no closing slash",
          "severity": "error"
        },
        {
          "value": "unterminated-string",
          "doc": "a string literal has no closing quote",
          "severity": "error"
        },
        {
          "value": "use-cycle",
          "doc": "a flow uses itself, directly or through other flows",
          "severity": "error"
        }
      ]
    },
