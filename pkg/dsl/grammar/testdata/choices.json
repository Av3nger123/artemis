{
  "schemaVersion": 1,
  "choices": {
    "action": {
      "doc": "The action-block openers that are not an HTTP verb: run is a terminal step, browser is a browser step.",
      "values": [
        {
          "value": "run"
        },
        {
          "value": "browser"
        }
      ]
    },
    "browserAction": {
      "doc": "The statements legal inside a browser block. takesValue is whether the action takes a value as well as a selector.",
      "values": [
        {
          "value": "goto",
          "example": "goto \"/orders\""
        },
        {
          "value": "click",
          "example": "click \"text=Sign in\""
        },
        {
          "value": "fill",
          "takesValue": true,
          "example": "fill \"#email\" = \"alice@example.com\""
        },
        {
          "value": "select",
          "takesValue": true,
          "example": "select \"#plan\" = \"pro\""
        },
        {
          "value": "press",
          "example": "press \"Enter\""
        },
        {
          "value": "hover",
          "example": "hover \".menu\""
        },
        {
          "value": "upload",
          "takesValue": true,
          "example": "upload \"#avatar\" = \"me.png\""
        },
        {
          "value": "wait",
          "example": "wait \"1s\""
        }
      ]
    },
    "builtin": {
