(* The Artemis scenario language, in full. Quoted words are literal source
   text; Ident, String, Number, Regex and Bool are lexical tokens described
   under LEXICAL TOKENS below. Nothing in a .art file is outside this. *)

(* A file is one of three: a collection of items, a flow of steps, or the
   scenarios that run a flow with their data. *)
File          = CollectionFile | FlowFile | ScenarioFile ;
CollectionFile = { Import } Collection ;
(* A flow file: its imports and one flow, whose name is what reports print.
   The vars at the top of the flow are the values its scenarios may set. A
   flow runs only through a scenario file that names it. *)
FlowFile      = { Import } FlowDecl ;
FlowDecl      = "flow" Ident "{" { ConfigDecl | VarDecl | StepDecl | UseDecl | PhaseDecl | Flow } "}" ;
(* A scenario file: the flow it runs, relative to it, on its first line, then
   scenarios that hold data only. Sets may share a line. *)
ScenarioFile  = FlowRef { DataScenario } ;
FlowRef       = "flow" String ;
DataScenario  = "scenario" String "{" { TagsDecl | Set } "}" ;
Set           = Ident "=" ( Expr | "skip" ) ;
Import        = "import" String [ "as" Ident ] ;
Collection    = "collection" String "{" { ItemDecl } "}" ;
(* The keyword is the item's type, and the action must be one it holds: a
   request an HTTP verb, a command run, a query db. The vars above the action
   are the item's inputs, and the vars after it its outputs. *)
ItemDecl      = ( "request" | "command" | "query" ) Ident
                "{" { VarDecl } Action { StepStmt } "}" ;

(* Lower-case words, written out: a run selects before it evaluates. *)
TagsDecl      = "tags" "=" "[" [ String { "," String } ] "]" ;
(* setup runs before the scenario's steps and teardown after them, so setup is
   written above the first step and teardown below the last. *)
PhaseDecl     = ( "setup" | "teardown" ) "{" { StepDecl | UseDecl | Flow } "}" ;

Flow          = "parallel" FlowBody
              | "if" Expr FlowBody { "else" "if" Expr FlowBody } [ "else" FlowBody ]
              | "switch" Expr "{" { "case" Expr FlowBody } [ "default" FlowBody ] "}"
              | "try" FlowBody [ "catch" FlowBody ] [ "finally" FlowBody ]
              | "repeat" { RepeatOption } FlowBody "until" Expr ;
RepeatOption  = ( "every" | "within" | "max" ) Expr ;
FlowBody      = "{" { StepDecl | UseDecl | Flow } "}" ;
(* A step that calls a collection item: its lines set the item's inputs, and
   override what it sends and expects. as prefixes the vars it writes. *)
UseDecl       = "step" String "=" ItemRef [ "as" Ident ] "{" { UseLine } "}" ;
ItemRef       = Ident "." Ident ;
UseLine       = Ident "=" Expr
              | ReqField
              | "body" "." Ident { "." Ident } "=" Expr
              | "drop" ( "expects" | "captures" | "vars" )
              | Expect ;

ConfigDecl    = "config" ( "browser" "{" [ BrowserSetting { Sep BrowserSetting } ] "}"
                         | "http" "{" [ HTTPSetting { Sep HTTPSetting } ] "}" ) ;
BrowserSetting = "headless" "=" Bool | "viewport" "=" Expr ;
HTTPSetting   = "cookies" "=" Bool ;

VarDecl       = [ "private" ] "var" Ident [ "=" Expr ] ;
StepDecl      = "step" String "{" Action { StepStmt } "}" ;

Action        = Request | Run | Browser | DB ;
Request       = Method String [ "{" [ ReqField { Sep ReqField } ] "}" ] ;
Method        = "get" | "post" | "put" | "patch" | "delete" | "head" | "options" ;
ReqField      = "header" String "=" Expr
              | "query"  String "=" Expr
              | "body"   "=" Expr
              | "form"   String "=" Expr
              | "multipart" String "=" Expr ;
Run           = "run" Expr [ "{" [ RunField { Sep RunField } ] "}" ] ;
RunField      = "args" "=" Array | "cwd" "=" Expr | "stdin" "=" Expr
              | "env" "{" [ EnvSetting { Sep EnvSetting } ] "}" ;
EnvSetting    = Ident "=" Expr ;
DB            = "db" Expr [ "{" [ DBField { Sep DBField } ] "}" ] ;
DBField       = "sql" "=" Expr | "args" "=" Array | "command" "=" Expr ;
Browser       = "browser" "{" { BrowserAct } "}" ;
BrowserAct    = "goto"   Expr
              | "click"  Expr
              | "press"  Expr
              | "hover"  Expr
              | "wait"   Expr
              | "fill"   Expr "=" Expr
              | "select" Expr "=" Expr
              | "upload" Expr "=" Expr ;

(* A var after the action writes a name the steps below read. A later write
   of the name replaces it. *)
StepStmt      = Expect | StepVar | Retry | Timeout ;
Expect        = "expect" Expr [ "within" String ] ;
StepVar       = "var" Ident "=" Expr ;
Retry         = "retry" "{" [ RetryField { Sep RetryField } ] "}" ;
RetryField    = "times" "=" Number | "delay" "=" String ;
Timeout       = "timeout" "=" String ;
Sep           = "," | newline ;

Expr          = Or ;
Or            = And { "or" And } ;
And           = Not { "and" Not } ;
Not           = "not" Not | Cmp ;
Cmp           = Unary [ BinOp Unary | "exists" | "is" TypeName ] ;
BinOp         = "==" | "!=" | "<" | "<=" | ">" | ">="
              | "contains" | "matches" ;
TypeName      = "string" | "number" | "boolean" | "object" | "array" | "null" | "file" ;
Unary         = "-" Unary | Postfix ;
Postfix       = Primary { "." Ident | "[" Expr "]" } ;
Primary       = Number | String | Regex | Bool | "null" | Ident
              | Object | Array | Call | "(" Expr ")" ;
Call          = Builtin "(" [ Expr { "," Expr } ] ")" ;
Object        = "{" [ String ":" Expr { "," String ":" Expr } [ "," ] ] "}" ;
Array         = "[" [ Expr { "," Expr } [ "," ] ] "]" ;

(* Builtin is the closed set of callables. Which of them are in scope depends
   on the step type: see SCOPES below. *)
Builtin       = "env" | "match"
              | "uuid" | "now" | "random_int" | "random_string"
              | "base64" | "base64_decode" | "url_encode" | "sha256" | "hmac_sha256" | "jwt_claims"
              | "to_json" | "from_json" | "len" | "number" | "string"
              | "json" | "csv" | "file"
              | "text" | "value" | "attr" | "count" | "visible" ;

(* Reserved words are not reachable from File. They lex as ordinary
   identifiers and are rejected wherever a name is expected, so that a later
   tier of the language can take them without a breaking change. *)
Reserved      = "if" | "else" | "for" | "in" | "while" | "parallel" | "group"
              | "fn" | "return" | "import" | "use" | "let" | "setup" | "teardown"
              | "ai" | "skip" ;
