# Every node kind the encoding has, once each, in as few lines as the grammar
# allows -- so that the golden pinning the UI contract is a file somebody can
# actually read. `bad` is the exception: it is only produced by a file that did
# not parse, and parser-recover.json covers it.
scenario "kinds" {
  config browser { headless = true }

  var num = -1
  var re = /.+@.+/
  var nothing = null
  var obj = {"a": [1, "two"], "b": {}}
  var url = "${num}/x"

  step "api" {
    get "${url}/orders" {
      header "Accept" = "application/json"
      body = {"q": 1}
    }
    timeout = "5s"
    retry { times = 2, delay = "1s" }
    expect status == 200 within "10s"
    expect not (body.items[0].id exists) and body.count is number
    capture id = body.items[0].id
  }

  step "terminal" {
    # above the run
    run "psql" { # opening the run block
      args = ["-f", "seed.sql"]
      env { PGHOST = "localhost" }
    }
    expect stdout contains "COPY"
  }

  step "db" {
    db env("DB_URL") {
      sql = "SELECT id FROM orders WHERE id = $1"
      args = [id]
    }
    expect affected == 1
  }

  step "browser" {
    browser { # opening the browser block
      goto "/a" # trailing a browser action
      fill "#email" = "a@b.c"
      # above the browser block's closing brace
    }
    expect text("[role=status]") contains "Pro"
  }
}

scenario "blocks" {
  parallel {
    step "a" {
      run "true"
    }
  }

  if 1 == 1 {
    step "b" {
      run "true"
    }
  } else if 1 == 2 {
    step "c" {
      run "true"
    }
  } else {
    step "d" {
      run "true"
    }
  }

  switch 1 {
    case 1 {
      step "e" {
        run "true"
      }
    }
    default {
      step "f" {
        run "true"
      }
    }
  }

  try {
    step "g" {
      run "true"
    }
  } catch {
    step "h" {
      run "true"
    }
  } finally {
    step "i" {
      run "true"
    }
  }

  repeat every "1s" max 3 {
    step "j" {
      run "echo"
      capture out = stdout
    }
  } until out == "done"
}

scenario "row ${n}" for secret n in [1, 2] {
  tags = ["smoke"]

  setup {
    step "before" {
      run "true"
    }
  }

  step "s" {
    run "echo"
  }

  teardown {
    step "after" {
      run "true"
    }
  }
}
