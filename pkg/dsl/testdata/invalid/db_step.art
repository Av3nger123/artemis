# The db step's own mistakes, each on its own step so every one is reported.
#
# A scheme written out is checked when the file compiles, because a typo in it
# would otherwise surface only after the steps above had run. A URL from a var
# or env() is the usual case and is checked when the step runs.

scenario orders {
  secret var pg = env("ORDERS_DB")

  step misspelled_scheme as "misspelled scheme" {
    db "postgress://app@localhost/orders" { sql = "SELECT 1" }
    expect affected == 1
  }

  step nothing_to_run as "nothing to run" {
    db pg
    expect rows exists
  }

  step args_with_no_sql as "args with no sql" {
    db pg { args = [1] }
  }

  step unknown_field as "unknown field" {
    db pg {
      query = "SELECT 1"
      sql = "SELECT 1"
    }
  }

  step an_api_root as "an api root" {
    db pg { sql = "SELECT 1" }
    expect status == 200
  }

  step sql_and_a_command as "sql and a command" {
    db pg {
      sql = "SELECT 1"
      command = ["PING"]
    }
  }

  step sql_to_mongodb as "sql to mongodb" {
    db "mongodb://localhost:27017/shop" { sql = "SELECT 1" }
  }

  step a_command_to_postgres as "a command to postgres" {
    db "postgres://localhost/shop" { command = {"find": "orders"} }
  }

  step args_with_a_command as "args with a command" {
    db "redis://localhost:6379" {
      command = ["GET", "k"]
      args = [1]
    }
    expect result == "v"
  }

  step rows_outside_a_db_step as "rows outside a db step" {
    get "https://example.com/orders"
    expect rows[0].id == 1
  }
}
