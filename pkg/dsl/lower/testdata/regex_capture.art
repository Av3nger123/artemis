# pkg/cli/testdata/regex_capture.yaml, said in the DSL.
#
# A capture off a body that is not JSON at all. The first step's response is
# plain text, so there is no path to read -- match() reads the bytes of `raw`
# -- and the value is templated into the second step's url, which is what
# proves a capture landed in the scenario's scope.
#
# The YAML spells the extraction `itemId: {regex: "/items/([0-9]+)"}`. Here it
# is an ordinary expression, so the pattern is a regex literal the checker
# compiles and whose capturing groups it counts.

scenario "regex capture" {
  var base = env("SERVER")

  step "read the redirect" {
    get "${base}/redirect"
    expect status == 200
    capture itemId = match(raw, /\/items\/([0-9]+)/)
  }

  step "read the item back" {
    get "${base}/items/${itemId}"
    expect status == 200
    expect body.id == 42
  }
}
