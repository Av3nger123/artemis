# ART-54: the `secret` modifier on a var.
#
# `secret` is positional and not a keyword, so this file also pins the name it
# must not take away: a var called `secret` is legal below.
scenario "secrets" {
  secret var pw  = env("API_PASSWORD")
  var        url = env("API_URL")
  var        secret = "not the modifier"

  step "get a token" {
    post "${url}/token" {
      header "Content-Type" = "application/json"
      body = {"username": "alice", "password": pw}
    }
    expect status == 200
  }
}
