scenario "good password" {
  step "log in" {
    post "https://example.com/login" {
      body = {"password": "right"}
    }
    expect status == 200
  }
}

scenario "bad password" {
  step "log in" {
    post "https://example.com/login" {
      body = {"password": "wrong"}
    }
    expect status == 401
  }
}
