# A comment at the very top of the file, before anything else.

# A second paragraph of comment, separated by a blank line, above the scenario.
scenario "comments everywhere" { # trailing the opening brace
  # above the config
  config browser { headless = true } # trailing the config

  var url = env("API_URL") # trailing a var

  # above the step
  step "one" { # trailing the step's brace
    # above the action
    get "${url}/a" { # trailing the request's brace
      # above a field
      query "q" = 1 # trailing a field
      header "Accept" = "text/plain"
      # above the closing brace of the block
    } # trailing the block's closing brace

    # above the expect
    expect status == 200 # trailing the expect
    expect body.items[0].id == 1 # a comment after an index
    # above the closing brace of the step
  } # trailing the step's closing brace
  # above the closing brace of the scenario
} # trailing the scenario's closing brace

# And a comment at the very end of the file, which lives on the EOF token.
