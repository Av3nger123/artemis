# ART-54: the `secret` modifier, in both positions the grammar allows it.
#
# `secret` is positional and not a keyword, so this file also pins the two
# names it must not take away: a var called `secret` and a capture called
# `secret` are both legal below.
scenario "secrets" {
  secret var pw = env("API_PASSWORD")
  var url = env("API_URL")
  var secret = "not the modifier"

  step "get a token" {
    post "${url}/token" {
      header "Content-Type" = "application/json"
      body = {"username": "alice", "password": pw}
    }
    expect status == 200
    secret capture token = body.data.access_token
    capture secret_kind = body.data.kind
  }

  step "list the orders" {
    get "${url}/orders" { header "Authorization" = "Bearer ${token}" }
    expect status == 200
  }
}
