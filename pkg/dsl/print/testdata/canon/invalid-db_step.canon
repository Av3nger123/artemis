# The db step's own mistakes, each on its own step so every one is reported.
#
# A scheme written out is checked when the file compiles, because a typo in it
# would otherwise surface only after the steps above had run. A URL from a var
# or env() is the usual case and is checked when the step runs.

scenario "orders" {
  secret var pg = env("ORDERS_DB")

  step "misspelled scheme" {
    db "postgress://app@localhost/orders" { sql = "SELECT 1" }
    expect affected == 1
  }

  step "nothing to run" {
    db pg
    expect rows exists
  }

  step "args with no sql" {
    db pg { args = [1] }
  }

  step "unknown field" {
    db pg {
      query = "SELECT 1"
      sql = "SELECT 1"
    }
  }

  step "an api root" {
    db pg { sql = "SELECT 1" }
    expect status == 200
  }

  step "rows outside a db step" {
    get "https://example.com/orders"
    expect rows[0].id == 1
  }
}
