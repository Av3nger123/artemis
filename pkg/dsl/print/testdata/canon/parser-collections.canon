import "auth.art"

collection "orders" {
  request create(sku, qty = 1, base = env("API_URL")) {
    post "${base}/orders" { body = {"sku": sku, "qty": qty} }
    expect status == 201
    capture order_id = body.data.id
  }

  request pay(order_id, secret card, base = env("API_URL")) {
    post "${base}/orders/${order_id}/pay" { body = {"card": card} }
    expect status == 200
  }

  # An item's inputs are the vars above its action, and its keyword is its
  # type: a request holds an api action, a command a run, a query a db.
  request login {
    var user = "admin"
    var base = env("API_URL")

    post "${base}/login" { body = {"user": user} }
    capture token = body.token
  }

  command migrate {
    var target = "migrate"

    run "make" { args = [target] }
    expect exit_code == 0
  }

  query seed {
    var db_url = env("DB_URL")

    db db_url { sql = "select 1" }
  }
}

scenario "rush" {
  use orders.create as rush {
    sku = "A-1"
    header "X-Priority" = "high"
    body.qty = 5
    drop expects
    drop captures
    expect status == 202
  }
  use orders.pay { order_id = rush_order_id, card = env("CARD"), header "X-Trace" = "1" }
}
