# Everything on as few lines as the grammar allows: no separators between the
# declarations in the scenario body, commas where the grammar has a Sep.
# Canonical mode breaks the structural blocks -- scenario, step, browser -- so
# this file and spread.art reach the same shape from opposite starting points,
# differing only in the blank lines spread.art asks for.
scenario "compact" {
  var url = env("API_URL")

  step "one" {
    get "${url}/a" {
      query "q" = 1
      header "Accept" = "text/plain"
    }
    expect status == 200
    capture id = body.id
  }

  step "two" {
    browser {
      goto "/b"
      click "#go"
    }
    expect page.title contains "B"
  }
}
