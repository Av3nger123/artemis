# The value builtins, run by all three backends: what each makes of a fixed
# input is pinned to a published value -- a SHA-256 test vector, a base64
# encoding a reader can check by hand -- so a backend that agrees with the
# others about a wrong answer still fails. The random and clock builtins are
# asserted by shape, which is all a value nobody chose can be held to.

# conformance: pass
scenario "the value builtins agree" {
  var base  = env("ARTEMIS_BASE_URL")
  var token = "eyJhbGciOiJub25lIn0.eyJzdWIiOiI0MiIsInJvbGUiOiJhZG1pbiJ9.sig"
  var id    = uuid()

  step "make values and send one" {
    get "${base}/done" {
      query "user" = random_string(8)
    }
    timeout = "10s"

    expect status == 200
    expect len(id) == 36
    expect id matches /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/
    expect now("date") matches /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/
    expect now() matches /^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$/
    expect now("unix") > 1700000000
    expect now("unix_ms") > 1700000000000
    expect random_int(1, 6) >= 1 and random_int(1, 6) <= 6
    expect random_int(3, 3) == 3
    expect len(random_string(12)) == 12
    expect random_string(12) matches /^[a-z0-9]{12}$/
    expect base64("user:password") == "dXNlcjpwYXNzd29yZA=="
    expect base64_decode("dXNlcjpwYXNzd29yZA") == "user:password"
    expect url_encode("a b&c/d~") == "a+b%26c%2Fd~"
    expect sha256("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    expect hmac_sha256("key", "The quick brown fox jumps over the lazy dog") == "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8"
    expect jwt_claims(token).role == "admin"
    expect jwt_claims(token).sub == "42"
    expect to_json({"b": 1, "a": [true, null, "x"]}) == "{\"a\":[true,null,\"x\"],\"b\":1}"
    expect from_json("{\"n\": 2}").n == 2
    expect len([1, 2, 3]) == 3
    expect len({"a": 1}) == 1
    expect len("héllo") == 5
    expect number("42") == 42
    expect number(" 1.5 ") == 1.5
    expect string(200) == "200"
  }
}

# conformance: fail
scenario "a value builtin that cannot answer fails the scenario" {
  var base = env("ARTEMIS_BASE_URL")

  step "read a number out of a word" {
    get "${base}/done"
    timeout = "10s"

    expect status == 200
    expect number("forty-two") == 42
  }
}
