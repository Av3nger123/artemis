# Data and files, run by all three backends: json() and csv() read the same
# values, and a file() is sent the same way as a body, a urlencoded or multipart
# form, a command's stdin and its argument. The fixture's /echo describes what it
# was sent, so each assert reads what actually crossed the wire.

# conformance: pass
scenario "data and files are read and sent alike" {
  var base  = env("ARTEMIS_BASE_URL")
  var users = json("data/users.json")
  var rows  = csv("data/users.csv")
  var hello = file("data/hello.txt")

  step "read the data" {
    get "${base}/echo"
    timeout = "10s"

    expect status == 200
    expect users[1].name == "bob"
    expect len(rows) == 2
    expect rows[1].name == "bob, jr"
    expect rows[0].plan == "pro"
    expect hello is file
    expect base64(hello) == "aGVsbG8K"
    expect sha256(hello) == sha256("hello\n")
  }

  step "a file as the body" {
    post "${base}/echo" {
      header "Content-Type" = "text/plain"
      body = hello
    }
    timeout = "10s"

    expect body.body == "hello\n"
    expect body.length == 6
  }

  step "a urlencoded form" {
    post "${base}/echo" {
      form "plan" = users[0].plan
      form "n" = 2
    }
    timeout = "10s"

    expect body.content_type contains "application/x-www-form-urlencoded"
    expect body.form.plan == "pro"
    expect body.form.n == "2"
  }

  step "a multipart form" {
    post "${base}/echo" {
      multipart "greeting" = hello
      multipart "who" = "alice"
    }
    timeout = "10s"

    expect body.content_type contains "multipart/form-data"
    expect body.files.greeting.filename == "hello.txt"
    expect body.files.greeting.size == 6
    expect body.form.who == "alice"
  }

  step "a file as stdin" {
    run "cat" {
      stdin = hello
    }
    timeout = "10s"

    expect stdout == "hello\n"
  }

  step "a file as an argument" {
    run "cat" {
      args = [hello]
    }
    timeout = "10s"

    expect stdout == "hello\n"
  }
}

# conformance: fail
scenario "a file that is not there fails the scenario" {
  var base = env("ARTEMIS_BASE_URL")
  var dir  = "data/"

  step "name a missing file" {
    get "${base}/echo"
    timeout = "10s"

    expect file("${dir}nope.txt") is file
  }
}
