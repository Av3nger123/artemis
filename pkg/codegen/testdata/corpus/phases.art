# setup and teardown: setup's steps run first, the scenario's own after them,
# and teardown's last whatever happened -- a teardown step that reads a capture
# no step made is skipped.

scenario "checkout" {
  var url = "https://example.test"

  setup {
    step "make a cart" {
      post "${url}/carts"
      expect status == 201
      capture cart_id = body.id
    }
  }

  step "pay" {
    post "${url}/pay"
    expect status == 200
    capture order_id = body.id
  }

  teardown {
    step "cancel the order" {
      delete "${url}/orders/${order_id}"
    }

    step "say done" {
      run "true"
    }
  }
}
