# A scenario's cookie jar and how long each step took: `config http`, the
# `cookies` root, and `duration_ms` in a step of each type.

scenario "a session" {
  config http { cookies = true }

  step "log in" {
    post "https://example.test/login"
    expect cookies.sid.http_only == true
    expect duration_ms < 2000
    capture sid = cookies.sid.value
  }

  step "a command" {
    run "true"
    expect duration_ms >= 0
  }

  step "a page" {
    browser {
      goto "https://example.test/"
    }
    expect duration_ms < 30000
  }
}

scenario "no jar" {
  config http { cookies = false }

  step "anonymous" {
    get "https://example.test/session"
    expect raw == "none"
  }
}
