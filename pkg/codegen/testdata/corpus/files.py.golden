# Generated by `artemis build --lang=python` from testdata/corpus/files.art.
#
# This is a ONE-WAY EXPORT. Artemis does not read it back: the .art file is the
# source of truth, and running the command again overwrites this file. Once you
# decide to own this instead, edit it freely and stop generating it.
#
# Where this differs from `artemis run` on the same scenario:
#   - a comparison uses Python's rules, so `status == "200"` does not hold
#     against a JSON 200 the way it does under the interpreter;
#   - a step that wrote no `timeout` has none here; artemis applies a default of
#     its own per step type;
#   - stdout and stderr are not truncated; artemis caps them for its report;
#   - a variable with no value raises at the point of use. `artemis run`
#     reports all of them before the first step; an exported module has no
#     such moment;
#   - a file json(), csv() or file() names is found from the directory the
#     test runs in, by the .art file's path as it was given to `artemis
#     build`; a file sent as a body has no Content-Type the step did not write.

import csv
import json
import mimetypes
import os
import subprocess
import time
from urllib.parse import urljoin, urlparse

import pytest
import requests
from playwright.sync_api import expect, sync_playwright


def art_render(value):
    """Render a value the way artemis does when it goes into a string: a whole
    number without a trailing .0, a boolean as true or false, null as "null",
    and a list or an object as compact JSON. This is eval.Render, which is what
    makes a URL built here and a URL built by `artemis run` the same string."""
    if value is None:
        return "null"
    if isinstance(value, str):
        return value
    if hasattr(value, "art_path"):
        return value.art_path
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, float) and value.is_integer():
        return str(int(value))
    if isinstance(value, (int, float)):
        return repr(value)
    return json.dumps(value, separators=(",", ":"))


def art_json(response):
    """What an api step binds to `body`: the response decoded as any JSON
    value, or None when it is not JSON. A body that is not JSON is not a
    failure -- whether the step needed one is what its asserts say."""
    try:
        return response.json()
    except ValueError:
        return None


def art_type(value):
    """A value's JSON type, in the names `is` accepts, or "file" for a file()."""
    if value is None:
        return "null"
    if hasattr(value, "art_path"):
        return "file"
    if isinstance(value, bool):
        return "boolean"
    if isinstance(value, str):
        return "string"
    if isinstance(value, (int, float)):
        return "number"
    if isinstance(value, (list, tuple)):
        return "array"
    if isinstance(value, dict) or hasattr(value, "keys"):
        return "object"
    return "unknown"


def art_is(value, want):
    """`expr is <type>`, over the six JSON type names and file."""
    return art_type(value) == want


def art_contains(haystack, needle):
    """`contains`: a substring of a string, an element of an array, or a key of
    an object. The three readings come from the left operand's type, which is
    eval's rule; a left operand of any other type is a mistake with no honest
    false, so it raises."""
    if isinstance(haystack, str):
        if needle is None or isinstance(needle, (list, tuple, dict)):
            raise TypeError("contains against a string needs a string")
        return art_render(needle) in haystack
    if isinstance(haystack, (list, tuple)):
        return needle in haystack
    if isinstance(haystack, dict) or hasattr(haystack, "keys"):
        return needle in haystack
    raise TypeError("contains needs a string, array or object on the left")


class ArtFile:
    """A file a scenario named with file(): its path, not its contents. Where a
    step sends content the file's bytes are sent; anywhere else it is its
    absolute path -- eval.File's rule."""

    def __init__(self, path):
        self.art_path = os.path.abspath(path)

    def __eq__(self, other):
        return isinstance(other, ArtFile) and other.art_path == self.art_path

    def __repr__(self):
        return "file(%r)" % self.art_path


def art_file(path):
    """`file(path)`: the file at path, which has to be there and not be a
    directory."""
    if not os.path.isfile(path):
        raise FileNotFoundError("file(): there is no file %s" % path)
    return ArtFile(path)


def art_read_json(path):
    """`json(path)`: the value a JSON file holds."""
    with open(path, encoding="utf-8") as data:
        return json.load(data)


def art_read_csv(path):
    """`csv(path)`: a CSV file as a list of dicts, the first row naming the
    columns and every cell a string. A row with more or fewer cells than the
    header is an error, and so is a column named twice."""
    with open(path, newline="", encoding="utf-8") as data:
        rows = list(csv.reader(data))
    if not rows:
        return []
    header = rows[0]
    if len(set(header)) != len(header):
        raise ValueError("csv(): %s names a column twice" % path)
    out = []
    for number, row in enumerate(rows[1:], start=2):
        if len(row) != len(header):
            raise ValueError("csv(): %s line %d has %d cells, and the header %d"
                             % (path, number, len(row), len(header)))
        out.append(dict(zip(header, row)))
    return out


def art_body(value):
    """A request body: a file's bytes, or the value rendered as the interpreter
    renders it -- an object as compact JSON."""
    if hasattr(value, "art_path"):
        with open(value.art_path, "rb") as data:
            return data.read()
    return art_render(value)


def art_part(value):
    """One multipart field, as requests' files= takes it: a file as its base name,
    its bytes and a type from its extension, and text as a field with no file
    name."""
    if hasattr(value, "art_path"):
        kind = mimetypes.guess_type(value.art_path)[0] or "application/octet-stream"
        with open(value.art_path, "rb") as data:
            return (os.path.basename(value.art_path), data.read(), kind)
    return (None, art_render(value))


def art_stdin(value):
    """A command's input: a file's text, or the value rendered."""
    if hasattr(value, "art_path"):
        with open(value.art_path, encoding="utf-8") as data:
            return data.read()
    return art_render(value)


def art_files(value):
    """What an upload attaches: a file's path, a list of files' paths, or a
    path written as a string."""
    if hasattr(value, "art_path"):
        return value.art_path
    if isinstance(value, list) and value and all(hasattr(item, "art_path") for item in value):
        return [item.art_path for item in value]
    return art_render(value)


def art_goto(page, target):
    """`goto`: a relative target resolves against where the page already is.

    That is artemis's rule and not playwright's -- a context with no base URL
    answers a bare "/orders" with a protocol error -- so the resolution happens
    here, and the first `goto` of a scenario needs a full URL for the same reason
    it does under the interpreter."""
    if urlparse(target).scheme:
        page.goto(target)
        return
    here = page.url
    if not here or here == "about:blank":
        raise ValueError(
            "goto %r is relative and the page has not been anywhere yet "
            "(the first goto of a scenario needs a full URL)" % (target,))
    page.goto(urljoin(here, target))


def art_within(ask, seconds):
    """`within` on a browser assertion that has no native playwright expect()
    shape: re-ask it every 100ms until it holds or the budget expires, which is
    the settle loop pkg/steps/browserstep runs. The last try is unguarded, so a
    budget that runs out reports the real reason rather than a bare False."""
    deadline = time.monotonic() + seconds
    while True:
        last = time.monotonic() >= deadline
        try:
            if ask():
                return True
        except Exception:
            if last:
                raise
        else:
            if last:
                return False
        time.sleep(0.1)


@pytest.fixture
def browser():
    """One playwright page per test function, which is one scenario: the DSL
    gives a scenario one browser session and its steps share it.

    The fixture yields a factory rather than a page because `config browser` is
    written per scenario while a fixture is shared by the file. A test calls
    browser(headless=..., viewport=...) and gets its own page; everything opened
    is closed when the test ends."""
    opened = []
    with sync_playwright() as play:

        def open_page(headless=True, viewport=""):
            chrome = play.chromium.launch(headless=headless)
            opened.append(chrome)
            size = None
            if viewport:
                width, _, height = viewport.partition("x")
                size = {"width": int(width), "height": int(height)}
            return chrome.new_page(viewport=size)

        yield open_page
        for chrome in opened:
            chrome.close()


# scenario "files", line 4
def test_files(browser):
    users = art_read_json("testdata/corpus/data/users.json")
    rows = art_read_csv("testdata/corpus/data/users.csv")
    logo = art_file("testdata/corpus/fixtures/logo.png")
    page = browser()
    http = requests.Session()

    # step "send them", line 9
    resp = http.post(
        "https://example.test/avatars",
        files=[("avatar", art_part(logo)), ("who", art_part(users[0]["name"]))],
    )
    status, body, raw, headers = (
        resp.status_code, art_json(resp), resp.text, resp.headers)
    assert status == 201
    assert art_is(logo, "file")

    # step "a form", line 18
    resp = http.post(
        "https://example.test/login",
        data=[("user", art_render(rows[0]["name"]))],
    )
    status, body, raw, headers = (
        resp.status_code, art_json(resp), resp.text, resp.headers)
    assert status == 200

    # step "a body", line 25
    resp = http.put("https://example.test/logo", data=art_body(logo))
    status, body, raw, headers = (
        resp.status_code, art_json(resp), resp.text, resp.headers)
    assert status == 204

    # step "a command", line 32
    proc = subprocess.run(
        ["wc", "-c", art_render(logo)],
        input=art_stdin(logo),
        capture_output=True,
        text=True,
        check=False,
    )
    exit_code, stdout, stderr = proc.returncode, proc.stdout, proc.stderr
    assert exit_code == 0

    # step "an upload", line 40
    art_goto(page, "https://example.test/")
    page.set_input_files("#avatar", art_files([logo, logo]))
    assert art_within(lambda: art_contains(page.url, "example"), 5.0)
