# Data and files: json(), csv() and file(), `is file`, and a file sent every way
# a step sends content -- a body, a form, a multipart part, stdin, an upload.

scenario "files" {
  var users = json("data/users.json")
  var rows  = csv("data/users.csv")
  var logo  = file("fixtures/logo.png")

  step "send them" {
    post "https://example.test/avatars" {
      multipart "avatar" = logo
      multipart "who" = users[0].name
    }
    expect status == 201
    expect logo is file
  }

  step "a form" {
    post "https://example.test/login" {
      form "user" = rows[0].name
    }
    expect status == 200
  }

  step "a body" {
    put "https://example.test/logo" {
      body = logo
    }
    expect status == 204
  }

  step "a command" {
    run "wc" {
      args = ["-c", logo]
      stdin = logo
    }
    expect exit_code == 0
  }

  step "an upload" {
    browser {
      goto "https://example.test/"
      upload "#avatar" = [logo, logo]
    }
    expect page.url contains "example"
  }
}
