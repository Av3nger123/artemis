# Where this differs from `artemis run` on the same scenario:
#   - a comparison uses Python's rules, so `status == "200"` does not hold
#     against a JSON 200 the way it does under the interpreter;
#   - a step that wrote no `timeout` has none here; artemis applies a default of
#     its own per step type;
#   - stdout and stderr are not truncated; artemis caps them for its report;
#   - a variable with no value raises at the point of use. `artemis run`
#     reports all of them before the first step; an exported module has no
#     such moment.

import json

import requests


def art_render(value):
    """Render a value the way artemis does when it goes into a string: a whole
    number without a trailing .0, a boolean as true or false, null as "null",
    and a list or an object as compact JSON. This is eval.Render, which is what
    makes a URL built here and a URL built by `artemis run` the same string."""
    if value is None:
        return "null"
    if isinstance(value, str):
        return value
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, float) and value.is_integer():
        return str(int(value))
    if isinstance(value, (int, float)):
        return repr(value)
    return json.dumps(value, separators=(",", ":"))


def art_json(response):
    """What an api step binds to `body`: the response decoded as any JSON
    value, or None when it is not JSON. A body that is not JSON is not a
    failure -- whether the step needed one is what its asserts say."""
    try:
        return response.json()
    except ValueError:
        return None


# scenario "sign in", line 4
def test_sign_in():
    # step "post the form", line 5
    resp = requests.post(
        "https://example.test/session",
        data=art_render({"email": "alice@example.test"}),
    )
    status, body, raw, headers = (
        resp.status_code, art_json(resp), resp.text, resp.headers)
    assert status == 200


