    http = requests.Session()

    # step "post the form again", line 14
    resp = http.post(
        "https://example.test/session",
        data=art_body({"email": "bob@example.test"}),
    )
    status, body, raw, headers = (
        resp.status_code, art_json(resp), resp.text, resp.headers)
    assert status == 200


