// Generated by `artemis build --lang=js` from testdata/corpus/values.art.
//
// This is a ONE-WAY EXPORT. Artemis does not read it back: the .art file is the
// source of truth, and running the command again overwrites this file. Once you
// decide to own this instead, edit it freely and stop generating it.
//
// Run it with `npx vitest run`. It needs `npm install -D vitest`, and
// `@playwright/test` as well for a scenario with a browser step.
//
// Where this differs from `artemis run` on the same scenario:
//   - a comparison uses JavaScript's rules, so `status == "200"` does not hold
//     against a JSON 200 the way it does under the interpreter;
//   - a step that wrote no `timeout` has none here; artemis applies a default of
//     its own per step type;
//   - stdout and stderr are not truncated; artemis caps them for its report;
//   - a variable with no value raises at the point of use. `artemis run`
//     reports all of them before the first step; an exported module has no
//     such moment;
//   - vite owns two environment variables, so `env("BASE_URL")` reads vite's
//     own base path here and `env("NODE_ENV")` reads the mode vitest ran in.
//     Name yours something else.

import { createHash, createHmac, randomUUID } from "node:crypto";

import { expect, test } from "vitest";

function art_render(value) {
  // Render a value the way artemis does when it goes into a string: a whole
  // number without a trailing .0, a boolean as true or false, null as "null",
  // and an array or an object as compact JSON. This is eval.Render, which is
  // what makes a URL built here and a URL built by `artemis run` the same string.
  if (value === null || value === undefined) return "null";
  if (typeof value === "string") return value;
  if (typeof value === "boolean") return value ? "true" : "false";
  if (typeof value === "number") return String(value);
  return JSON.stringify(value);
}

function art_json(text) {
  // What an api step binds to `body`: the response decoded as any JSON value,
  // or null when it is not JSON. A body that is not JSON is not a failure --
  // whether the step needed one is what its asserts say.
  //
  // Over the text rather than response.json(), because a fetch body is a stream
  // that can be read once and `raw` needs it too.
  try {
    return JSON.parse(text);
  } catch {
    return null;
  }
}

function art_url(base, pairs) {
  // A request's query parameters, appended in source order.
  //
  // fetch has no params option, so the URL is built here. A list of pairs rather
  // than an object, because source order is kept and a repeated `query "tag"`
  // keeps both values -- which an object would silently collapse.
  // URLSearchParams does the percent-escaping lower.queryString does by hand.
  const url = new URL(base);
  for (const [name, value] of pairs) url.searchParams.append(name, value);
  return url.href;
}

function art_at(root, ...path) {
  // A path read: `body.meta.owner.name` and `body.items[0]` both arrive here as
  // one call with the whole path, so a deep read is one line and not four
  // nested ones.
  //
  // It throws on a key that is not there, which is the whole reason it exists.
  // JavaScript's own `body.missing` is undefined, so `expect body.missing is null`
  // would hold here and fail under both the interpreter and the generated
  // pytest -- where the subscript raises KeyError. An unresolvable path is an
  // errored assertion in all three.
  let value = root;
  for (const key of path) {
    if (value instanceof Headers) {
      // The `headers` root is fetch's own Headers, whose get() is
      // case-insensitive -- which is the lookup eval.Headers does.
      if (!value.has(key)) throw new Error(`there is no header ${JSON.stringify(key)}`);
      value = value.get(key);
      continue;
    }
    if (value === null || value === undefined || typeof value !== "object") {
      throw new TypeError(`${JSON.stringify(key)} cannot be read off ${art_render(value)}`);
    }
    if (Array.isArray(value)) {
      if (typeof key !== "number" || key < 0 || key >= value.length) {
        throw new Error(`there is no element ${art_render(key)}`);
      }
    } else if (!Object.hasOwn(value, key)) {
      throw new Error(`there is no ${JSON.stringify(String(key))}`);
    }
    value = value[key];
  }
  return value;
}

function art_eq(a, b) {
  // Equality for a comparison with no scalar literal on either side.
  //
  // Structural, because Python's `==` is -- so the two exports answer the same
  // thing about two arrays, where JavaScript's own `===` would compare
  // references. A comparison against a literal is emitted as `===` and never
  // reaches this.
  if (a === b) return true;
  if (a === null || a === undefined || b === null || b === undefined) {
    return (a ?? null) === (b ?? null);
  }
  if (typeof a !== typeof b || typeof a !== "object") return false;
  if (Array.isArray(a) !== Array.isArray(b)) return false;
  if (Array.isArray(a)) {
    return a.length === b.length && a.every((e, i) => art_eq(e, b[i]));
  }
  const keys = Object.keys(a);
  return (
    keys.length === Object.keys(b).length &&
    keys.every((k) => Object.hasOwn(b, k) && art_eq(a[k], b[k]))
  );
}

async function art_exists(read) {
  // `expr exists`: false for a path that does not resolve and false for a JSON
  // null, which is eval's rule -- a null is treated as absent, and `exists` is
  // the operator for asking rather than an error.
  //
  // The read is a function because an absent path throws out of art_at:
  // evaluating it before the call would throw where this has to answer false.
  // Async because the operand may be an element read, which is a promise on
  // this side of the export and was synchronous on the Python one.
  try {
    return (await read()) != null;
  } catch {
    return false;
  }
}

function art_str(name, value) {
  // The text a builtin's argument has to be: eval converts each argument to
  // what its parameter takes, and a value that is not text is a mistake.
  if (typeof value !== "string") {
    throw new TypeError(`${name}()'s argument must be a string, got ${JSON.stringify(value)}`);
  }
  return value;
}

function art_uuid() {
  // `uuid()`: a random version 4 UUID. The interpreter seeds its generator
  // so --seed repeats a failed run; a generated test is not repeating one.
  return randomUUID();
}

function art_now(format = "rfc3339") {
  // `now()`: the time in UTC, as a timestamp with no fraction, a date, or
  // seconds or milliseconds since the epoch -- eval's four formats and no other.
  const moment = new Date();
  switch (format) {
    case "rfc3339":
      return moment.toISOString().replace(/\.\d+Z$/, "Z");
    case "date":
      return moment.toISOString().slice(0, 10);
    case "unix":
      return Math.floor(moment.getTime() / 1000);
    case "unix_ms":
      return moment.getTime();
  }
  throw new Error(
    `now()'s argument must be one of rfc3339, date, unix, unix_ms, got ${JSON.stringify(format)}`,
  );
}

function art_whole(name, value) {
  // A count or a bound, read the way eval reads one: a number, or text that
  // reads as one, with no fractional part and small enough to be exact.
  const number = art_number(value);
  if (!Number.isInteger(number) || Math.abs(number) > 2 ** 53) {
    throw new Error(`${name}()'s argument must be a whole number, got ${JSON.stringify(value)}`);
  }
  return number;
}

function art_random_int(low, high) {
  // `random_int(min, max)`: a whole number from min to max, both included.
  low = art_whole("random_int", low);
  high = art_whole("random_int", high);
  if (low > high) {
    throw new Error(`random_int()'s bounds are the wrong way round: ${low} is above ${high}`);
  }
  return low + Math.floor(Math.random() * (high - low + 1));
}

function art_random_string(length) {
  // `random_string(n)`: n characters of a-z and 0-9, n from 1 to 256.
  length = art_whole("random_string", length);
  if (length < 1 || length > 256) {
    throw new Error(
      `random_string() makes 1 to 256 characters, and this call asks for ${length}`,
    );
  }
  const alphabet = "abcdefghijklmnopqrstuvwxyz0123456789";
  let out = "";
  for (let i = 0; i < length; i++) out += alphabet[Math.floor(Math.random() * alphabet.length)];
  return out;
}

function art_base64(text) {
  // `base64(text)`: standard base64, padded.
  return Buffer.from(art_str("base64", text), "utf8").toString("base64");
}

function art_base64_decode(text) {
  // `base64_decode(text)`: standard or URL-safe base64, padded or not. Buffer
  // skips a character it cannot read rather than refusing it, so the text is
  // checked first: eval refuses it, and the two have to agree.
  const clean = art_str("base64_decode", text).trim().replace(/-/g, "+").replace(/_/g, "/");
  if (!/^[A-Za-z0-9+/]*={0,2}$/.test(clean) || clean.replace(/=+$/, "").length % 4 === 1) {
    throw new Error(`base64_decode()'s argument is not base64: ${JSON.stringify(text)}`);
  }
  return Buffer.from(clean, "base64").toString("utf8");
}

function art_url_encode(text) {
  // `url_encode(text)`: query escaping, a space as +. encodeURIComponent
  // leaves five characters Go's url.QueryEscape escapes, and writes a space as
  // %20, so both are put right after it.
  return encodeURIComponent(art_str("url_encode", text))
    .replace(/[!'()*]/g, (c) => "%" + c.charCodeAt(0).toString(16).toUpperCase())
    .replace(/%20/g, "+");
}

function art_sha256(text) {
  // `sha256(text)`: the digest of the text's UTF-8 bytes, in lower-case hex.
  return createHash("sha256").update(art_str("sha256", text), "utf8").digest("hex");
}

function art_hmac_sha256(key, text) {
  // `hmac_sha256(key, text)`: the HMAC-SHA256 of the text under the key, in
  // lower-case hex.
  return createHmac("sha256", art_str("hmac_sha256", key))
    .update(art_str("hmac_sha256", text), "utf8")
    .digest("hex");
}

function art_jwt_claims(token) {
  // `jwt_claims(token)`: the token's payload, decoded and NOT verified. A test
  // asserts what a token says; whether the right key signed it is the
  // service's business.
  const parts = art_str("jwt_claims", token).trim().split(".");
  if (parts.length !== 3) {
    throw new Error(
      `jwt_claims()'s argument is not a JWT: it has ${parts.length} part(s), and a JWT has 3`,
    );
  }
  const claims = JSON.parse(art_base64_decode(parts[1]));
  if (claims === null || typeof claims !== "object" || Array.isArray(claims)) {
    throw new Error("jwt_claims(): the token's payload is not an object");
  }
  return claims;
}

function art_to_json(value) {
  // `to_json(value)`: compact JSON with its keys in order -- the text the
  // interpreter makes of the same value.
  const plain = (item) => {
    if (item instanceof RegExp) throw new TypeError("to_json() cannot write a regular expression");
    if (Array.isArray(item)) return item.map(plain);
    if (item !== null && typeof item === "object") {
      return Object.fromEntries(Object.keys(item).sort().map((key) => [key, plain(item[key])]));
    }
    return item;
  };
  return JSON.stringify(plain(value));
}

function art_from_json(text) {
  // `from_json(text)`: the value JSON text holds.
  return JSON.parse(art_str("from_json", text));
}

function art_len(value) {
  // `len(value)`: the characters in a string -- code points, as Go counts
  // runes, not UTF-16 units -- the items in an array, the keys of an object.
  if (typeof value === "string") return [...value].length;
  if (Array.isArray(value)) return value.length;
  if (value !== null && typeof value === "object" && !(value instanceof RegExp)) {
    return Object.keys(value).length;
  }
  throw new TypeError(`len() measures a string, an array or an object, not ${JSON.stringify(value)}`);
}

function art_number(value) {
  // `number(value)`: a number, or text that reads as one. A boolean is not a
  // number, and neither is empty text, which Number() would read as zero.
  let result = NaN;
  if (typeof value === "number") result = value;
  else if (typeof value === "string" && value.trim() !== "") result = Number(value.trim());
  if (!Number.isFinite(result)) {
    throw new Error(`number() cannot read ${JSON.stringify(value)} as a number`);
  }
  return result;
}

function art_string(value) {
  // `string(value)`: the text the value has in an interpolation.
  return art_render(value);
}

// scenario "values", line 4
test("values", async () => {
  let id, when, pick, word, basic, status, body, raw, headers, resp;
  id = art_uuid();
  when = art_now("unix_ms");
  pick = art_random_int(1, 10);
  word = art_random_string(8);
  basic = art_base64("user:password");

  // step "send them", line 11
  resp = await fetch(
    art_url("https://example.test/orders", [["q", art_render(art_url_encode("a b"))]]),
    {
      method: "POST",
      headers: { "Authorization": `Basic ${art_render(basic)}`, "X-Signature": art_render(art_hmac_sha256("key", art_to_json({ "id": id }))) },
      body: art_render({ "id": id, "at": when, "pick": pick, "word": word, "digest": art_sha256(word) }),
    },
  );
  raw = await resp.text();
  status = resp.status;
  body = art_json(raw);
  headers = resp.headers;
  expect(status === 201, 'status == 201').toBe(true);
  expect(art_eq(art_at(art_jwt_claims(art_at(body, "token")), "sub"), id), 'jwt_claims(body.token).sub == id').toBe(true);
  expect(art_at(art_from_json(art_at(body, "payload")), "ok") === true, 'from_json(body.payload).ok == true').toBe(true);
  expect(art_eq(art_len(art_at(body, "items")), art_number("3")), 'len(body.items) == number("3")').toBe(true);
  expect(art_string(art_at(body, "count")) === "3", 'string(body.count) == "3"').toBe(true);
  expect(art_base64_decode(art_at(body, "blob")) === "hi", 'base64_decode(body.blob) == "hi"').toBe(true);
  expect(await art_exists(() => art_now()), 'now() exists').toBe(true);
});
