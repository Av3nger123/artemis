  let status, body, raw, headers, resp;

  // step "post the form again", line 14
  resp = await fetch("https://example.test/session", {
    method: "POST",
    body: art_render({ "email": "bob@example.test" }),
  });
  raw = await resp.text();
  status = resp.status;
  body = art_json(raw);
  headers = resp.headers;
  expect(status === 200, 'status == 200').toBe(true);
});

