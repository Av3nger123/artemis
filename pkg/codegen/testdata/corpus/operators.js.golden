// Generated by `artemis build --lang=js` from testdata/corpus/operators.art.
//
// This is a ONE-WAY EXPORT. Artemis does not read it back: the .art file is the
// source of truth, and running the command again overwrites this file. Once you
// decide to own this instead, edit it freely and stop generating it.
//
// Run it with `npx vitest run`. It needs `npm install -D vitest`, and
// `@playwright/test` as well for a scenario with a browser step.
//
// Where this differs from `artemis run` on the same scenario:
//   - a comparison uses JavaScript's rules, so `status == "200"` does not hold
//     against a JSON 200 the way it does under the interpreter;
//   - a step that wrote no `timeout` has none here; artemis applies a default of
//     its own per step type;
//   - stdout and stderr are not truncated; artemis caps them for its report;
//   - a variable with no value raises at the point of use. `artemis run`
//     reports all of them before the first step; an exported module has no
//     such moment;
//   - vite owns two environment variables, so `env("BASE_URL")` reads vite's
//     own base path here and `env("NODE_ENV")` reads the mode vitest ran in.
//     Name yours something else;
//   - a scenario's cookies are kept by name: two cookies of one name for two
//     paths keep the later one, where artemis keeps both, and a redirect
//     fetch follows does not send or keep them;
//   - a file json(), csv() or file() names is found from the directory the
//     test runs in, by the .art file's path as it was given to `artemis
//     build`; a file sent as a body has no Content-Type the step did not write;
//   - teardown stops at its first failing step, where artemis runs every one.

import { expect, test } from "vitest";

function art_render(value) {
  // Render a value the way artemis does when it goes into a string: a whole
  // number without a trailing .0, a boolean as true or false, null as "null",
  // and an array or an object as compact JSON. This is eval.Render, which is
  // what makes a URL built here and a URL built by `artemis run` the same string.
  if (value === null || value === undefined) return "null";
  if (typeof value === "string") return value;
  if (typeof value === "boolean") return value ? "true" : "false";
  if (typeof value === "number") return String(value);
  if (value.art_path !== undefined) return value.art_path;
  return JSON.stringify(value);
}

function art_json(text) {
  // What an api step binds to `body`: the response decoded as any JSON value,
  // or null when it is not JSON. A body that is not JSON is not a failure --
  // whether the step needed one is what its asserts say.
  //
  // Over the text rather than response.json(), because a fetch body is a stream
  // that can be read once and `raw` needs it too.
  try {
    return JSON.parse(text);
  } catch {
    return null;
  }
}

function art_at(root, ...path) {
  // A path read: `body.meta.owner.name` and `body.items[0]` both arrive here as
  // one call with the whole path, so a deep read is one line and not four
  // nested ones.
  //
  // It throws on a key that is not there, which is the whole reason it exists.
  // JavaScript's own `body.missing` is undefined, so `expect body.missing is null`
  // would hold here and fail under both the interpreter and the generated
  // pytest -- where the subscript raises KeyError. An unresolvable path is an
  // errored assertion in all three.
  let value = root;
  for (const key of path) {
    if (value instanceof Headers) {
      // The `headers` root is fetch's own Headers, whose get() is
      // case-insensitive -- which is the lookup eval.Headers does.
      if (!value.has(key)) throw new Error(`there is no header ${JSON.stringify(key)}`);
      value = value.get(key);
      continue;
    }
    if (value === null || value === undefined || typeof value !== "object") {
      throw new TypeError(`${JSON.stringify(key)} cannot be read off ${art_render(value)}`);
    }
    if (Array.isArray(value)) {
      if (typeof key !== "number" || key < 0 || key >= value.length) {
        throw new Error(`there is no element ${art_render(key)}`);
      }
    } else if (!Object.hasOwn(value, key)) {
      throw new Error(`there is no ${JSON.stringify(String(key))}`);
    }
    value = value[key];
  }
  return value;
}

function art_eq(a, b) {
  // Equality for a comparison with no scalar literal on either side.
  //
  // Structural, because Python's `==` is -- so the two exports answer the same
  // thing about two arrays, where JavaScript's own `===` would compare
  // references. A comparison against a literal is emitted as `===` and never
  // reaches this.
  if (a === b) return true;
  if (a === null || a === undefined || b === null || b === undefined) {
    return (a ?? null) === (b ?? null);
  }
  if (typeof a !== typeof b || typeof a !== "object") return false;
  if (Array.isArray(a) !== Array.isArray(b)) return false;
  if (Array.isArray(a)) {
    return a.length === b.length && a.every((e, i) => art_eq(e, b[i]));
  }
  const keys = Object.keys(a);
  return (
    keys.length === Object.keys(b).length &&
    keys.every((k) => Object.hasOwn(b, k) && art_eq(a[k], b[k]))
  );
}

async function art_exists(read) {
  // `expr exists`: false for a path that does not resolve and false for a JSON
  // null, which is eval's rule -- a null is treated as absent, and `exists` is
  // the operator for asking rather than an error.
  //
  // The read is a function because an absent path throws out of art_at:
  // evaluating it before the call would throw where this has to answer false.
  // Async because the operand may be an element read, which is a promise on
  // this side of the export and was synchronous on the Python one.
  try {
    return (await read()) != null;
  } catch {
    return false;
  }
}

function art_type(value) {
  // A value's JSON type, in the names `is` accepts.
  if (value === null || value === undefined) return "null";
  if (typeof value === "boolean") return "boolean";
  if (typeof value === "string") return "string";
  if (typeof value === "number") return "number";
  if (value.art_path !== undefined) return "file";
  if (Array.isArray(value)) return "array";
  if (typeof value === "object") return "object";
  return "unknown";
}

function art_is(value, want) {
  // `expr is <type>`, over the six JSON type names and file.
  return art_type(value) === want;
}

function art_contains(haystack, needle) {
  // `contains`: a substring of a string, an element of an array, or a key of an
  // object. The three readings come from the left operand's type, which is
  // eval's rule; a left operand of any other type is a mistake with no honest
  // false, so it throws.
  if (typeof haystack === "string") {
    if (needle === null || needle === undefined || typeof needle === "object") {
      throw new TypeError("contains against a string needs a string");
    }
    return haystack.includes(art_render(needle));
  }
  if (Array.isArray(haystack)) return haystack.some((e) => art_eq(e, needle));
  if (haystack instanceof Headers) return haystack.has(art_render(needle));
  if (haystack !== null && typeof haystack === "object") {
    return Object.hasOwn(haystack, needle);
  }
  throw new TypeError("contains needs a string, array or object on the left");
}

function art_regexp(pattern) {
  // A pattern position takes a regex literal or a string -- the rule `matches`
  // and `match()` already follow, so a pattern can live in a var. A literal is
  // emitted as a RegExp and arrives here as one.
  return pattern instanceof RegExp ? pattern : new RegExp(pattern);
}

function art_matches(subject, pattern) {
  // `matches`: an unanchored search, as a regex usually is. A composite or a
  // null has no rendering worth matching and throws rather than matching
  // "null".
  if (subject === null || subject === undefined || typeof subject === "object") {
    throw new TypeError("matches needs a string on the left");
  }
  return art_regexp(pattern).test(art_render(subject));
}

function art_match(subject, pattern) {
  // `match(text, /re/)`: capturing group 1 when the pattern has one and the
  // whole match when it has none. Two groups is a mistake rather than a choice,
  // and a pattern that matched nothing is an error rather than an empty string
  // -- the text was there and the question was asked. The value is always a
  // string, because reading "007" as seven loses data.
  const re = art_regexp(pattern);
  // JavaScript has no RegExp.groups, so the count comes from a pattern that
  // matches the empty string: the source with an empty alternative after it
  // always matches, and the result's length is one more than the group count.
  const groups = new RegExp(`${re.source}|`).exec("").length - 1;
  if (groups > 1) {
    throw new Error(
      `pattern ${re} has ${groups} capturing groups; match() takes one or none`,
    );
  }
  const found = re.exec(art_render(subject));
  if (found === null) throw new Error(`pattern ${re} matched nothing`);
  return groups === 1 ? found[1] : found[0];
}

function art_set_cookies(resp) {
  // Every Set-Cookie header of a response, parsed: name, value and attributes,
  // an attribute the server did not send as null. Read off the headers as the
  // interpreter reads them.
  const out = [];
  for (const line of resp.headers.getSetCookie()) {
    const parts = line.split(";").map((part) => part.trim());
    const eq = parts[0].indexOf("=");
    if (eq <= 0) continue;
    const raw = parts[0].slice(eq + 1).trim();
    const quoted = raw.length > 1 && raw.startsWith('"') && raw.endsWith('"');
    const value = quoted ? raw.slice(1, -1) : raw;
    const cookie = {
      name: parts[0].slice(0, eq).trim(), value, domain: null, path: null, expires: null,
      maxAge: null, secure: false, http_only: false, same_site: null,
    };
    for (const attribute of parts.slice(1)) {
      const at = attribute.indexOf("=");
      const key = (at < 0 ? attribute : attribute.slice(0, at)).trim().toLowerCase();
      const setting = at < 0 ? "" : attribute.slice(at + 1).trim();
      if (key === "domain" && setting) cookie.domain = setting;
      else if (key === "path" && setting) cookie.path = setting;
      else if (key === "expires" && setting && !Number.isNaN(Date.parse(setting))) {
        cookie.expires = new Date(setting).toISOString().replace(/\.\d+Z$/, "Z");
      } else if (key === "max-age" && /^-?\d+$/.test(setting)) cookie.maxAge = Number(setting);
      else if (key === "secure") cookie.secure = true;
      else if (key === "httponly") cookie.http_only = true;
      else if (key === "samesite" && ["lax", "strict", "none"].includes(setting.toLowerCase())) {
        cookie.same_site = setting.toLowerCase();
      }
    }
    out.push(cookie);
  }
  return out;
}

function art_jar() {
  // A scenario's cookie jar, which fetch does not keep: what a response sets is
  // sent on the scenario's later requests to the same host, as the interpreter
  // and a browser do. Keyed by name, so two cookies of one name on two paths
  // keep the later one -- a suite talks to the services it names, and this
  // is the jar those tests need, not a browser's.
  return new Map();
}

async function art_fetch(jar, url, options) {
  // fetch, with the scenario's jar: its cookies are sent unless the step wrote
  // its own Cookie header -- a test of a forged session must not be handed the
  // real one -- and what the response sets is stored either way. A null jar is
  // a scenario that wrote `config http { cookies = false }`.
  if (jar === null) return fetch(url, options);
  const target = new URL(url);
  const headers = { ...(options.headers ?? {}) };
  if (!Object.keys(headers).some((name) => name.toLowerCase() === "cookie")) {
    const now = Date.now();
    const sent = [];
    for (const [name, c] of jar) {
      const host = target.hostname;
      const domainOk = c.hostOnly ? host === c.domain : host === c.domain || host.endsWith("." + c.domain);
      if (!domainOk || !target.pathname.startsWith(c.path)) continue;
      if (c.secure && target.protocol !== "https:") continue;
      if (c.expires !== null && c.expires <= now) continue;
      sent.push(name + "=" + c.value);
    }
    if (sent.length > 0) headers.Cookie = sent.join("; ");
  }
  const resp = await fetch(url, { ...options, headers });
  for (const c of art_set_cookies(resp)) {
    // Max-Age wins over Expires, as it does in every jar.
    const expires =
      c.maxAge !== null ? Date.now() + c.maxAge * 1000 : c.expires === null ? null : Date.parse(c.expires);
    if (expires !== null && expires <= Date.now()) {
      jar.delete(c.name);
      continue;
    }
    jar.set(c.name, {
      value: c.value,
      domain: (c.domain ?? target.hostname).replace(/^\./, ""),
      hostOnly: c.domain === null,
      path: c.path ?? "/",
      secure: c.secure,
      expires,
    });
  }
  return resp;
}

// scenario "every operator", line 3
test("every operator", async () => {
  let pattern, ref, owner, status, body, raw, headers, resp;
  pattern = /ORD-[0-9]+/;
  const jar = art_jar();

  // step "the response says everything", line 6
  resp = await art_fetch(jar, "https://example.test/report", { method: "GET" });
  raw = await resp.text();
  status = resp.status;
  body = art_json(raw);
  headers = resp.headers;
  expect(status === 200, 'status == 200').toBe(true);
  expect(status !== 500, 'status != 500').toBe(true);
  expect(art_at(body, "count") > 0, 'body.count > 0').toBe(true);
  expect(art_at(body, "count") >= 1, 'body.count >= 1').toBe(true);
  expect(art_at(body, "count") < 100, 'body.count < 100').toBe(true);
  expect(art_at(body, "count") <= 99, 'body.count <= 99').toBe(true);
  expect(art_at(body, "delta") > -1, 'body.delta > -1').toBe(true);
  expect(art_contains(art_at(body, "title"), "ready"), 'body.title contains "ready"').toBe(true);
  expect(art_contains(art_at(body, "tags"), "urgent"), 'body.tags contains "urgent"').toBe(true);
  expect(art_contains(art_at(body, "meta"), "owner"), 'body.meta contains "owner"').toBe(true);
  expect(art_matches(art_at(body, "ref"), /ORD-[0-9]+/), 'body.ref matches /ORD-[0-9]+/').toBe(true);
  expect(art_matches(raw, pattern), 'raw matches pattern').toBe(true);
  expect(await art_exists(() => art_at(body, "owner")), 'body.owner exists').toBe(true);
  expect(!await art_exists(() => art_at(body, "error")), 'not body.error exists').toBe(true);
  expect(art_is(art_at(body, "title"), "string"), 'body.title is string').toBe(true);
  expect(art_is(art_at(body, "count"), "number"), 'body.count is number').toBe(true);
  expect(art_is(art_at(body, "ready"), "boolean"), 'body.ready is boolean').toBe(true);
  expect(art_is(art_at(body, "meta"), "object"), 'body.meta is object').toBe(true);
  expect(art_is(art_at(body, "tags"), "array"), 'body.tags is array').toBe(true);
  expect(art_is(art_at(body, "gap"), "null"), 'body.gap is null').toBe(true);
  expect(status === 200 && art_at(body, "ready") === true, 'status == 200 and body.ready == true').toBe(true);
  expect(status === 404 || status === 200, 'status == 404 or status == 200').toBe(true);
  expect((status === 200 || status === 201) && !(art_at(body, "stale") === true), '(status == 200 or status == 201) and not body.stale == true').toBe(true);
  expect(art_at(body, "tags", 0) === "urgent", 'body.tags[0] == "urgent"').toBe(true);
  expect(art_at(body, "meta", "owner", "name") === "alice", 'body.meta.owner.name == "alice"').toBe(true);
  expect(await art_exists(() => art_at(headers, "x-request-id")), 'headers["x-request-id"] exists').toBe(true);
  ref = art_match(raw, /ORD-([0-9]+)/);
  owner = art_at(body, "meta", "owner");
});
