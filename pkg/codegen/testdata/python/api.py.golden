# Generated by `artemis build --lang=python` from testdata/python/api.art.
#
# This is a ONE-WAY EXPORT. Artemis does not read it back: the .art file is the
# source of truth, and running the command again overwrites this file. Once you
# decide to own this instead, edit it freely and stop generating it.
#
# Where this differs from `artemis run` on the same scenario:
#   - a comparison uses Python's rules, so `status == "200"` does not hold
#     against a JSON 200 the way it does under the interpreter;
#   - a step that wrote no `timeout` has none here; artemis applies a default of
#     its own per step type;
#   - stdout and stderr are not truncated; artemis caps them for its report.

import json
import os
import time

import requests


def art_render(value):
    """Render a value the way artemis does when it goes into a string: a whole
    number without a trailing .0, a boolean as true or false, null as "null",
    and a list or an object as compact JSON. This is eval.Render, which is what
    makes a URL built here and a URL built by `artemis run` the same string."""
    if value is None:
        return "null"
    if isinstance(value, str):
        return value
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, float) and value.is_integer():
        return str(int(value))
    if isinstance(value, (int, float)):
        return repr(value)
    return json.dumps(value, separators=(",", ":"))


def art_json(response):
    """What an api step binds to `body`: the response decoded as any JSON
    value, or None when it is not JSON. A body that is not JSON is not a
    failure -- whether the step needed one is what its asserts say."""
    try:
        return response.json()
    except ValueError:
        return None


def art_contains(haystack, needle):
    """`contains`: a substring of a string, an element of an array, or a key of
    an object. The three readings come from the left operand's type, which is
    eval's rule; a left operand of any other type is a mistake with no honest
    false, so it raises."""
    if isinstance(haystack, str):
        if needle is None or isinstance(needle, (list, tuple, dict)):
            raise TypeError("contains against a string needs a string")
        return art_render(needle) in haystack
    if isinstance(haystack, (list, tuple)):
        return needle in haystack
    if isinstance(haystack, dict) or hasattr(haystack, "keys"):
        return needle in haystack
    raise TypeError("contains needs a string, array or object on the left")


class art_attempt:
    """One attempt of a retried step. Entered as a context manager: a failure
    inside the block is swallowed on every attempt but the last, which raises."""

    def __init__(self, last):
        self.last = last
        self.failed = False

    def __enter__(self):
        return self

    def __exit__(self, kind, value, trace):
        self.failed = kind is not None
        return self.failed and not self.last


def art_retry(times=1, delay=0.0):
    """`retry { times, delay }`: one attempt per iteration, with the delay
    between two of them. The step's action and its assertions are both inside the
    block, so they retry together -- and a `capture` written after them stays in
    the test function's own scope rather than inside a nested function."""
    attempts = max(1, times)
    for n in range(attempts):
        if n:
            time.sleep(delay)
        attempt = art_attempt(last=n == attempts - 1)
        yield attempt
        if not attempt.failed:
            return


# scenario "the orders api", line 2
def test_the_orders_api():
    base = os.environ.get("BASE_URL", "")

    # step "create one", line 5
    for attempt in art_retry(times=3, delay=1.0):
        with attempt:
            resp = requests.post(
                f"{art_render(base)}/orders",
                headers={"Content-Type": "application/json", "Authorization": "Bearer " + art_render(os.environ.get("TOKEN", ""))},
                data=art_render({"sku": "ART-1", "qty": 2, "gift": True, "note": None}),
                timeout=10.0,
            )
            status, body, raw, headers = (
                resp.status_code, art_json(resp), resp.text, resp.headers)
            assert status == 201
            id = body["id"]

    # step "read it back", line 18
    resp = requests.get(
        f"{art_render(base)}/orders/{art_render(id)}",
        params=[("fields", "id,total"), ("fields", "sku"), ("page", art_render(2))],
    )
    status, body, raw, headers = (
        resp.status_code, art_json(resp), resp.text, resp.headers)
    assert status == 200
    assert art_contains(raw, "ART-1")
    assert art_contains(headers["content-type"], "json")

    # step "replace it", line 30
    resp = requests.put(
        f"{art_render(base)}/orders/{art_render(id)}",
        data=art_render({"sku": "ART-2", "qty": 1}),
    )
    status, body, raw, headers = (
        resp.status_code, art_json(resp), resp.text, resp.headers)
    assert status == 200

    # step "amend it", line 37
    resp = requests.patch(
        f"{art_render(base)}/orders/{art_render(id)}",
        data=art_render({"qty": 4}),
    )
    status, body, raw, headers = (
        resp.status_code, art_json(resp), resp.text, resp.headers)
    assert status == 200

    # step "ask what it allows", line 44
    resp = requests.options(f"{art_render(base)}/orders/{art_render(id)}")
    status, body, raw, headers = (
        resp.status_code, art_json(resp), resp.text, resp.headers)
    assert status < 400

    # step "just the headers", line 49
    resp = requests.head(f"{art_render(base)}/orders/{art_render(id)}")
    status, body, raw, headers = (
        resp.status_code, art_json(resp), resp.text, resp.headers)
    assert status == 200

    # step "remove it", line 54
    resp = requests.delete(f"{art_render(base)}/orders/{art_render(id)}")
    status, body, raw, headers = (
        resp.status_code, art_json(resp), resp.text, resp.headers)
    assert status == 204
