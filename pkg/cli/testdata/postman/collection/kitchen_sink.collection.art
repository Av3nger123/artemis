# Generated by artemis generate from kitchen_sink.postman_collection.json.
collection "Orders API" {
  request health_ping {
    var base_url

    get "${base_url}/ping"
    expect status == 200
  }

  request orders_admin_list_orders {
    var access_token
    var base_url
    var page_size

    get "${base_url}/orders" {
      header "Authorization" = "Bearer ${access_token}"
      header "Accept" = "application/json"
      query "limit" = "${page_size}"
      query "tag" = "new"
    }
    expect status < 400
  }

  request orders_create_order {
    var access_token
    var base_url
    var operator

    post "${base_url}/orders" {
      header "Authorization" = "Bearer ${access_token}"
      header "Content-Type" = "application/json"
      body = {"note": "for ${operator}", "qty": 2, "sku": "A-1"}
    }
    expect status == 201
  }

  request orders_amend_order {
    var base_url

    put "${base_url}/orders/1" {
      header "Authorization" = "Basic YWRhOmxvdmVsYWNl"
      header "Content-Type" = "application/x-www-form-urlencoded"
      body = "note=rush+order&qty=3"
    }
    expect status < 400
  }

  request orders_search_orders {
    var access_token
    var base_url

    post "${base_url}/orders/search" {
      header "Content-Type" = "application/json"
      query "api_key" = "${access_token}"
      body = {"query": "query Orders($tag: String) {\n  orders(tag: $tag) { id }\n}", "variables": {"tag": "new"}}
    }
    expect status == 200
  }

  request legacy_raw_header_form {
    var access_token
    var base_url

    delete "${base_url}/orders/1" {
      header "Authorization" = "Bearer ${access_token}"
      header "X-Legacy" = "1"
      header "Accept" = "text/plain"
    }
    expect status < 400
  }
}
