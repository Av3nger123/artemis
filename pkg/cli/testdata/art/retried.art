# A service that is not up yet: two attempts fail, the third passes.
#
# The policy is resolved once, before the first attempt, and the attempt the
# step stops on replaces the earlier ones whole -- so the step line reads as a
# pass that took three tries rather than as three results.
scenario "wait for ready" {
  step "ping until ready" {
    get "%SERVER%/ready"
    retry { times = 3, delay = "50ms" }
    expect status == 200
    expect body.status == "ok"
  }
}
