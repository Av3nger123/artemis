# ART-17's semantics behind the `run` action block: a command that ran and
# exited non-zero is a *failed assertion*, not a step error, and the stderr
# expect is still made -- which is the rule that runs the other way from the
# api step, because stderr is exactly what a failure is diagnosed from and a
# check on it matters most when the command did not succeed.
flow terminal_2 {
  step "exit non-zero" {
    run "sh" { args = ["-c", "printf 'disk full' >&2; exit 2"] }
    expect exit_code == 0
    expect stderr contains "disk full"
  }
}
