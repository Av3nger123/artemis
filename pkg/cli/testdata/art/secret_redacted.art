# ART-54: a failed comparison against a `secret` binding.
#
# The credential must not appear anywhere in the transcript -- not in the console
# summary and not in the --report json document -- while the other operand and
# the line still do, because a block that withheld both would hide the
# comparison it is reporting.
scenario "secret redaction" {
  secret var pw = env("ART_SECRET_PW", "hunter2")

  step "compare" {
    get "%SERVER%/echo"
    expect status == 200
    expect body.given == pw
  }
}
