# A placeholder naming a variable nothing declares or captures. It is in the
# body on purpose: the offset the error reports is then a position in text the
# fixture controls, not one that moves with the test server's port.
scenario "undeclared variable" {
  step "ping" {
    post "%SERVER%/ping" { body = {"token": "${tokn}"} }
    expect status == 200
  }
}
