# A capture off a body that is not JSON at all. The first step's response is
# plain text, so there is no path to read -- the regex reads the bytes -- and the
# value is templated into the second step's url, which is what proves a capture
# landed in the scenario's scope.
flow regex_capture {
  var base = "%SERVER%"

  step read_the_redirect as "read the redirect" {
    get "${base}/redirect"
    expect status == 200
    var itemId = match(raw, /\/items\/([0-9]+)/)
  }

  step read_the_item_back as "read the item back" {
    get "${base}/items/${itemId}"
    expect status == 200
    expect body.id == 42
  }
}
