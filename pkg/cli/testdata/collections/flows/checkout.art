import "../auth.art"

flow checkout {
  var url = env("API_URL")

  step auth_login as "auth.login" = auth.login { user = "alice", password = "s3cret", base = url }

  step bad = auth.login as bad {
    user = "alice"
    password = "wrong"
    base = url
    drop expects
    drop vars
    expect status == 401
  }

  step orders {
    get "${url}/orders" { header "Authorization" = "Bearer ${token}" }
    expect status == 200
  }
}
